{
  "family": "tpcc",
  "seed": 42,
  "n_targets": 10,
  "repeats": 3,
  "budget": {"min_success": 100, "max_attempts": 300, "seed": 42},
  "parameters": [
    {"name": "warehouses",  "lo": 50,  "hi": 800, "scale": "log", "integer": true,
     "belief": {"type": "triangular", "lo": 50, "mode": 200, "hi": 800}},
    {"name": "threads",     "lo": 8,   "hi": 256, "scale": "log", "integer": true,
     "belief": {"type": "triangular", "lo": 8, "mode": 64, "hi": 256}},
    {"name": "write_ratio", "lo": 0.5, "hi": 0.95,
     "belief": {"type": "uniform", "lo": 0.5, "hi": 0.95, "mode": 0.88}},
    {"name": "skew",        "lo": 0.0, "hi": 1.0,
     "belief": {"type": "triangular", "lo": 0.0, "mode": 0.7, "hi": 1.0}}
  ],
  "methods": [
    {"type": "bisection", "theta": 0.9, "delta": 0.1, "max_probes": 3, "repeats": 3},
    {"type": "random", "match": "bisection", "seed": 7},
    {"type": "anchor"}
  ],
  "backend": {
    "type": "sim",
    "radii": {"warehouses:down": 400, "warehouses:up": 120, "threads:down": 30, "threads:up": null,
              "write_ratio:down": 0.2, "write_ratio:up": null, "skew:down": 0.4, "skew:up": 0.3},
    "exponents": {"warehouses": -0.5, "threads": 0.4},
    "noise_sigma": 0.04,
    "drop_prob": 0.0,
    "seed": 1
  },
  "out_dir": "prepare_runs/example_sim"
}
